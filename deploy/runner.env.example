# Copy to deploy/runner.env and fill in. Never commit runner.env.
#
# Gitea -> repo Settings -> Actions -> Runners -> "Create new runner"
# gives you this token. It is single-use: the runner swaps it for
# permanent credentials in the runner-data volume on first start.
GITEA_RUNNER_REGISTRATION_TOKEN=

# Optional: how this runner shows up in the Gitea runner list.
GITEA_RUNNER_NAME=wgmesh-ci
